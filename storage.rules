rules_version = '2';

// Files are checked against the Firestore documents they belong to (cross-service rules). Storage
// can only read the "(default)" database, which is why the app uses that one.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function clase(claseId) {
      return firestore.get(/databases/(default)/documents/clases/$(claseId)).data;
    }

    function esDelProfesor(claseId) {
      return clase(claseId).profesorId == request.auth.uid;
    }

    function inscripto(claseId) {
      return firestore.exists(/databases/(default)/documents/inscripciones/$(clase(claseId).profesorId + '_' + request.auth.uid + '_' + clase(claseId).instrumento));
    }

    // The profesor's plan is not blocked (same formula as venceDe / bloqueoDe in firestore.rules
    // and src/lib/planes.ts). Only get(): Storage reads at most 2 documents per request, and
    // uploading a material already reads the class. No plan record: get() fails and it is denied.
    // The admin account has everything enabled. Storage cannot read a third document to look it
    // up, so its uid is written here: the uid of documentos/4169298 (src/lib/admin.ts). If that
    // account is ever recreated, update it.
    function habilitado(uid) {
      return uid == 'ZUf7fQGacZPYqbcv1Px2C928SHx1' || habilitadoPorPlan(uid);
    }

    function habilitadoPorPlan(uid) {
      let s = firestore.get(/databases/(default)/documents/suscripciones/$(uid)).data;
      let vence = 'venceEn' in s ? s.venceEn : s.pruebaDesde + duration.value(30, 'd');
      let dia = (vence - duration.value(3, 'h')).dayOfWeek();
      return request.time < vence + duration.value(dia == 6 ? 6 : (dia == 7 ? 5 : 7), 'd');
    }

    // 200 MB per file; keep in sync with MAX_BYTES in src/lib/files.ts.
    function tamanoValido() {
      return request.resource.size < 200 * 1024 * 1024;
    }

    // The class is for the alumno signed in (without `alumnos`, for the whole list).
    function paraElAlumno(claseId) {
      return !('alumnos' in clase(claseId)) || request.auth.uid in clase(claseId).alumnos;
    }

    // Class materials: audio, video, PDF, images and sheet music (MusicXML).
    match /clases/{claseId}/{archivo} {
      allow read: if signedIn()
        && (esDelProfesor(claseId) || (inscripto(claseId) && paraElAlumno(claseId)));
      allow create: if signedIn() && esDelProfesor(claseId) && tamanoValido()
        && request.resource.contentType.matches('audio/.*|video/.*|image/.*|application/pdf|application/vnd[.]recordare[.].*|application/xml|text/xml|application/octet-stream')
        && habilitado(request.auth.uid);
      allow delete: if signedIn() && esDelProfesor(claseId);
    }

    // Alumno deliveries: audio and video (up to 200 MB), and photos or PDFs of written work
    // (up to 20 MB; keep in sync with MAX_BYTES_DOCUMENTO in src/lib/files.ts).
    match /entregas/{claseId}/{alumnoId}/{archivo} {
      allow read: if signedIn() && (alumnoId == request.auth.uid || esDelProfesor(claseId));
      allow create: if signedIn() && alumnoId == request.auth.uid && inscripto(claseId)
        && paraElAlumno(claseId) && tamanoValido()
        && (request.resource.contentType.matches('audio/.*|video/.*')
          || (request.resource.contentType.matches('image/.*|application/pdf')
            && request.resource.size < 20 * 1024 * 1024));
      // The profesor too: deleting a class deletes its deliveries.
      allow delete: if signedIn() && (alumnoId == request.auth.uid || esDelProfesor(claseId));
    }

    // The profesor's answer in audio or video to a delivery (entregas.devoluciones[].media). It
    // lives under the alumno's folder, so deleting that folder takes it too. The alumno can delete
    // it: removing their file removes the comments on it, with their recordings.
    match /entregas/{claseId}/{alumnoId}/devoluciones/{archivo} {
      allow read: if signedIn() && (alumnoId == request.auth.uid || esDelProfesor(claseId));
      allow create: if signedIn() && esDelProfesor(claseId) && tamanoValido()
        && request.resource.contentType.matches('audio/.*|video/.*')
        && habilitado(request.auth.uid);
      allow delete: if signedIn() && (alumnoId == request.auth.uid || esDelProfesor(claseId));
    }

    // Files a profesor keeps to reuse (bibliotecaArchivos): only they see them. Using one copies it
    // into the class, so deleting it here never touches a class.
    match /biblioteca/{uid}/{archivo} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create: if signedIn() && uid == request.auth.uid && tamanoValido()
        && request.resource.contentType.matches('audio/.*|video/.*|image/.*|application/pdf|application/vnd[.]recordare[.].*|application/xml|text/xml|application/octet-stream')
        && habilitado(request.auth.uid);
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    // Profile photo: one fixed file per user (usuarios/{uid}/foto.jpg, as in usuarios.foto).
    // Same readers as the profile in Firestore: the owner and every profesor. The app scales it
    // to 512 px JPEG, so 2 MB is plenty.
    match /usuarios/{uid}/foto.jpg {
      allow read: if signedIn() && (uid == request.auth.uid
        || firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'profesor');
      allow create, update: if signedIn() && uid == request.auth.uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if signedIn() && uid == request.auth.uid;
    }
  }
}
