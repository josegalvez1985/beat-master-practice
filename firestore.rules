rules_version = '2';

// Data model and the reasoning behind these rules: docs/arquitectura.md
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function usuario(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data;
    }

    function esProfesor() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(me()))
        && usuario(me()).rol == 'profesor';
    }

    // The alumno signed in belongs to that profesor's list for that instrument.
    function inscripto(profesorId, instrumento) {
      return exists(/databases/$(database)/documents/inscripciones/$(profesorId + '_' + me() + '_' + instrumento));
    }

    function instrumentosValidos(lista) {
      // Keep in sync with src/lib/instruments.ts.
      return lista is list && lista.size() >= 1 && lista.size() <= 11
        && lista.hasOnly(['guitarra', 'arpa', 'piano', 'bateria', 'voz', 'bajo', 'violin', 'acordeon', 'ukelele', 'saxofon', 'flauta']);
    }

    function textoValido(valor, min, max) {
      return valor is string && valor.size() >= min && valor.size() <= max;
    }

    // Keep the path in sync with fotoRuta in src/lib/files.ts and storage.rules.
    function fotoValida(uid, foto) {
      return foto is map && foto.keys().hasOnly(['ruta', 'actualizadoEn'])
        && foto.ruta == 'usuarios/' + uid + '/foto.jpg'
        && foto.actualizadoEn == request.time;
    }

    function archivosValidos(lista) {
      return lista is list && lista.size() <= 30;
    }

    // documentos/{nro_documento} -> { uid, email }: makes the document number unique and lets
    // the login turn it into the account email. Readable one by one, never listable.
    // documentos and usuarios point at each other and are only created together, in one batch,
    // and never deleted: neither can exist without the other.
    match /documentos/{nroDocumento} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && nroDocumento.matches('^[0-9]{5,10}$')
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == me()
        && request.resource.data.email == request.auth.token.email
        && getAfter(/databases/$(database)/documents/usuarios/$(me())).data.nro_documento == nroDocumento;
      allow update, delete: if false;
    }

    // usuarios/{uid}: public profile. The owner and every profesor (to find alumnos) can read it.
    match /usuarios/{uid} {
      allow read: if signedIn() && (uid == me() || esProfesor());
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['rol', 'nombre', 'nro_documento', 'instrumentos', 'terminos', 'creadoEn'])
        && request.resource.data.rol in ['alumno', 'profesor']
        && textoValido(request.resource.data.nombre, 2, 80)
        && getAfter(/databases/$(database)/documents/documentos/$(request.resource.data.nro_documento)).data.uid == me()
        && instrumentosValidos(request.resource.data.instrumentos)
        && request.resource.data.terminos is list && request.resource.data.terminos.size() <= 100
        && request.resource.data.creadoEn == request.time;
      // Role and document number never change. `foto` points at the owner's fixed Storage path,
      // so the profile and its photo file stay related one to one. `metaSemanal`: the alumno's
      // weekly practice goal in minutes (absent = no goal).
      allow update: if signedIn() && uid == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'instrumentos', 'terminos', 'foto', 'metaSemanal'])
        && (!('metaSemanal' in request.resource.data)
          || (request.resource.data.metaSemanal is int
            && request.resource.data.metaSemanal >= 1 && request.resource.data.metaSemanal <= 3000))
        && textoValido(request.resource.data.nombre, 2, 80)
        && instrumentosValidos(request.resource.data.instrumentos)
        && request.resource.data.terminos is list && request.resource.data.terminos.size() <= 100
        && (!('foto' in request.resource.data.diff(resource.data).affectedKeys())
          || !('foto' in request.resource.data)
          || fotoValida(uid, request.resource.data.foto));
      allow delete: if false;
    }

    // inscripciones/{profesorId}_{alumnoId}_{instrumento}: the profesor's student lists.
    match /inscripciones/{id} {
      allow read: if signedIn() && (resource.data.profesorId == me() || resource.data.alumnoId == me());
      allow create: if esProfesor()
        && request.resource.data.keys().hasOnly(['profesorId', 'profesorNombre', 'alumnoId', 'alumnoNombre', 'alumnoDocumento', 'instrumento', 'creadoEn'])
        && request.resource.data.profesorId == me()
        && id == me() + '_' + request.resource.data.alumnoId + '_' + request.resource.data.instrumento
        && request.resource.data.instrumento in usuario(me()).instrumentos
        && request.resource.data.profesorNombre == usuario(me()).nombre
        && usuario(request.resource.data.alumnoId).rol == 'alumno'
        && request.resource.data.alumnoNombre == usuario(request.resource.data.alumnoId).nombre
        && request.resource.data.alumnoDocumento == usuario(request.resource.data.alumnoId).nro_documento
        && request.resource.data.creadoEn == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.profesorId == me();
    }

    // `ficha` and `bloques` are the lesson plan (src/lib/plan.ts). Rules cannot loop over the
    // blocks, so they only bound their size; files in blocks live under clases/{claseId}/ like the
    // other materials and are deleted with the class (eliminarClase).
    function claseValida(data) {
      return data.keys().hasOnly(['profesorId', 'profesorNombre', 'instrumento', 'titulo', 'descripcion', 'fecha', 'materiales', 'creadoEn', 'ficha', 'bloques'])
        && textoValido(data.titulo, 1, 120)
        && textoValido(data.descripcion, 0, 4000)
        && data.fecha is string && data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && archivosValidos(data.materiales)
        && (!('ficha' in data) || (data.ficha is map
          && data.ficha.keys().hasOnly(['nivel', 'estilo', 'afinacion', 'capo', 'duracion', 'superficie', 'kit'])))
        && (!('bloques' in data) || (data.bloques is list && data.bloques.size() <= 40));
    }

    // clases/{id}: planned by a profesor; visible to the alumnos in that instrument's list.
    match /clases/{claseId} {
      allow read: if signedIn()
        && (resource.data.profesorId == me() || inscripto(resource.data.profesorId, resource.data.instrumento));
      allow create: if esProfesor()
        && request.resource.data.profesorId == me()
        && request.resource.data.profesorNombre == usuario(me()).nombre
        && request.resource.data.instrumento in usuario(me()).instrumentos
        && request.resource.data.creadoEn == request.time
        && claseValida(request.resource.data);
      allow update: if signedIn() && resource.data.profesorId == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['titulo', 'descripcion', 'fecha', 'materiales', 'ficha', 'bloques'])
        && claseValida(request.resource.data);
      allow delete: if signedIn() && resource.data.profesorId == me();
    }

    function clase(claseId) {
      return get(/databases/$(database)/documents/clases/$(claseId)).data;
    }

    function entregaValida(entregaId, data) {
      return data.keys().hasOnly(['claseId', 'profesorId', 'alumnoId', 'alumnoNombre', 'instrumento', 'archivos', 'comentario', 'actualizadoEn', 'devoluciones'])
        && entregaId == data.claseId + '_' + me()
        && data.alumnoId == me()
        && data.alumnoNombre == usuario(me()).nombre
        && data.profesorId == clase(data.claseId).profesorId
        && data.instrumento == clase(data.claseId).instrumento
        && inscripto(data.profesorId, data.instrumento)
        && archivosValidos(data.archivos) && data.archivos.size() >= 1
        && (!('comentario' in data) || textoValido(data.comentario, 0, 2000))
        && data.actualizadoEn == request.time;
    }

    // diario/{id}: what an alumno practiced (day, instrument, minutes, a note). It hangs from
    // usuarios (never deleted); the alumno creates and deletes their own entries, and a profesor
    // reads them only for an instrument they teach that alumno (the query filters by alumnoId
    // and instrumento, so the rule can check the enrollment).
    match /diario/{id} {
      allow read: if signedIn()
        && (resource.data.alumnoId == me()
          || exists(/databases/$(database)/documents/inscripciones/$(me() + '_' + resource.data.alumnoId + '_' + resource.data.instrumento)));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['alumnoId', 'instrumento', 'fecha', 'minutos', 'comentario', 'creadoEn'])
        && request.resource.data.alumnoId == me()
        && usuario(me()).rol == 'alumno'
        && instrumentosValidos([request.resource.data.instrumento])
        && request.resource.data.fecha is string && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.minutos is int
        && request.resource.data.minutos >= 1 && request.resource.data.minutos <= 600
        && textoValido(request.resource.data.comentario, 0, 500)
        && request.resource.data.creadoEn == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.alumnoId == me();
    }

    // records/{alumnoId}_{rudimento}: an alumno's best clean tempo for a drum rudiment. It hangs
    // from usuarios (never deleted); one per alumno and rudiment (deterministic id). The alumno
    // writes and deletes their own; their drum profesores read them (the query filters by
    // alumnoId, so the rule can check the enrollment).
    match /records/{id} {
      allow read: if signedIn()
        && (resource.data.alumnoId == me()
          || exists(/databases/$(database)/documents/inscripciones/$(me() + '_' + resource.data.alumnoId + '_bateria')));
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['alumnoId', 'rudimento', 'bpm', 'fecha', 'actualizadoEn'])
        && request.resource.data.alumnoId == me()
        && usuario(me()).rol == 'alumno'
        // Keep in sync with RUDIMENTOS in src/lib/bateria.ts: ids are only added, never removed
        // (a record would point at a rudiment that no longer exists).
        && request.resource.data.rudimento in ['simples', 'dobles', 'cinco-golpes', 'seis-golpes', 'paradiddle', 'doble-paradiddle', 'triple-paradiddle', 'paradiddle-diddle', 'flam', 'flam-tap', 'flam-accent', 'drag']
        && id == me() + '_' + request.resource.data.rudimento
        && request.resource.data.bpm is int
        && request.resource.data.bpm >= 20 && request.resource.data.bpm <= 300
        && request.resource.data.fecha is string && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.actualizadoEn == request.time;
      allow delete: if signedIn() && resource.data.alumnoId == me();
    }

    // asistenteUso/{uid}: the AI assistant's usage of one person (today's questions, the month's
    // tokens). One per user (same id), written only by the Cloud Function (Admin SDK); the owner
    // can read it. It hangs from usuarios, which are never deleted.
    match /asistenteUso/{uid} {
      allow read: if signedIn() && uid == me();
      allow write: if false;
    }

    // entregas/{claseId}_{alumnoId}: what an alumno uploads for a class. `devoluciones` are the
    // profesor's comments at a point of a file: stored inside the delivery, so they are deleted
    // with it (and with the class). The alumno never writes them, only removes them together with
    // the file they point at (the new list must be part of the old one).
    match /entregas/{entregaId} {
      // `resource == null`: the alumno listens to their delivery before it exists.
      allow read: if signedIn()
        && (resource == null || resource.data.alumnoId == me() || resource.data.profesorId == me());
      allow create: if signedIn() && entregaValida(entregaId, request.resource.data)
        && !('devoluciones' in request.resource.data);
      allow update: if signedIn()
        && ((entregaValida(entregaId, request.resource.data)
            && (!('devoluciones' in request.resource.data.diff(resource.data).affectedKeys())
              || resource.data.get('devoluciones', []).hasAll(request.resource.data.get('devoluciones', []))))
          || (resource.data.profesorId == me()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['devoluciones'])
            && request.resource.data.devoluciones is list
            && request.resource.data.devoluciones.size() <= 100));
      // The profesor too: deleting a class deletes its deliveries.
      allow delete: if signedIn() && (resource.data.alumnoId == me() || resource.data.profesorId == me());
    }
  }
}
