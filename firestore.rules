rules_version = '2';

// Data model and the reasoning behind these rules: docs/arquitectura.md
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function usuario(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data;
    }

    function esProfesor() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(me()))
        && usuario(me()).rol == 'profesor';
    }

    // The alumno signed in belongs to that profesor's list for that instrument.
    function inscripto(profesorId, instrumento) {
      return exists(/databases/$(database)/documents/inscripciones/$(profesorId + '_' + me() + '_' + instrumento));
    }

    function instrumentosValidos(lista) {
      // Keep in sync with src/lib/instruments.ts.
      return lista is list && lista.size() >= 1 && lista.size() <= 17
        && lista.hasOnly(['guitarra', 'arpa', 'piano', 'bateria', 'voz', 'bajo', 'violin', 'acordeon', 'ukelele', 'saxofon', 'flauta', 'requinto', 'teclado', 'trompeta', 'violonchelo', 'contrabajo', 'percusion']);
    }

    function textoValido(valor, min, max) {
      return valor is string && valor.size() >= min && valor.size() <= max;
    }

    // Keep the path in sync with fotoRuta in src/lib/files.ts and storage.rules.
    function fotoValida(uid, foto) {
      return foto is map && foto.keys().hasOnly(['ruta', 'actualizadoEn'])
        && foto.ruta == 'usuarios/' + uid + '/foto.jpg'
        && foto.actualizadoEn == request.time;
    }

    function archivosValidos(lista) {
      return lista is list && lista.size() <= 30;
    }

    // The profesor's plan (suscripciones/{uid}, src/lib/planes.ts): a 30-day trial or a paid plan,
    // then 5 working days to pay (Monday to Friday, Paraguay time, UTC-3: from a weekday the
    // same weekday next week, from Saturday or Sunday the next Friday). After that, creating
    // classes, adding alumnos and uploading files is blocked; nothing is deleted. Keep in sync
    // with src/lib/planes.ts, functions/src/planes.ts and storage.rules.
    // `venceEn` is set by a paid plan or by days the admin granted (also during the trial).
    function venceDe(s) {
      return 'venceEn' in s ? s.venceEn : s.pruebaDesde + duration.value(30, 'd');
    }

    function bloqueoDe(vence) {
      let dia = (vence - duration.value(3, 'h')).dayOfWeek();
      return vence + duration.value(dia == 6 ? 6 : (dia == 7 ? 5 : 7), 'd');
    }

    // No plan record (a profesor from before the plans, until /admin creates the trials): blocked.
    // The admin account (documentos/4169298, as in src/lib/admin.ts) has everything enabled.
    function habilitado(uid) {
      let ruta = /databases/$(database)/documents/suscripciones/$(uid);
      let admin = /databases/$(database)/documents/documentos/4169298;
      return (exists(admin) && get(admin).data.uid == uid)
        || (exists(ruta) && request.time < bloqueoDe(venceDe(get(ruta).data)));
    }

    // documentos/{nro_documento} -> { uid, email }: makes the document number unique and lets
    // the login turn it into the account email. Readable one by one, never listable.
    // documentos and usuarios point at each other and are only created together, in one batch,
    // and never deleted from the app: neither can exist without the other. "Eliminar mi cuenta"
    // deletes both in one batch from the eliminarCuenta Cloud Function (functions/src/cuenta.ts).
    match /documentos/{nroDocumento} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && nroDocumento.matches('^[0-9]{5,10}$')
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == me()
        && request.resource.data.email == request.auth.token.email
        && getAfter(/databases/$(database)/documents/usuarios/$(me())).data.nro_documento == nroDocumento;
      allow update, delete: if false;
    }

    // usuarios/{uid}: public profile. The owner and every profesor (to find alumnos) can read it.
    match /usuarios/{uid} {
      allow read: if signedIn() && (uid == me() || esProfesor());
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['rol', 'nombre', 'nro_documento', 'instrumentos', 'terminos', 'creadoEn'])
        && request.resource.data.rol in ['alumno', 'profesor']
        && textoValido(request.resource.data.nombre, 2, 80)
        && getAfter(/databases/$(database)/documents/documentos/$(request.resource.data.nro_documento)).data.uid == me()
        && instrumentosValidos(request.resource.data.instrumentos)
        && request.resource.data.terminos is list && request.resource.data.terminos.size() <= 100
        && request.resource.data.creadoEn == request.time
        // A profesor is born with the trial of their plan and their phone, in the same batch.
        && (request.resource.data.rol != 'profesor'
          || (existsAfter(/databases/$(database)/documents/suscripciones/$(uid))
            && existsAfter(/databases/$(database)/documents/telefonos/$(uid))));
      // Role and document number never change. `foto` points at the owner's fixed Storage path,
      // so the profile and its photo file stay related one to one. `metaSemanal`: the alumno's
      // weekly practice goal in minutes (absent = no goal). `recordatorio`: hour of the daily
      // practice reminder. `autoevaluacion`: the alumno's own level guess per instrument.
      allow update: if signedIn() && uid == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'instrumentos', 'terminos', 'foto', 'metaSemanal', 'recordatorio', 'autoevaluacion'])
        && (!('recordatorio' in request.resource.data)
          || (request.resource.data.recordatorio is int
            && request.resource.data.recordatorio >= 0 && request.resource.data.recordatorio <= 23))
        && (!('autoevaluacion' in request.resource.data)
          || (request.resource.data.autoevaluacion is map && request.resource.data.autoevaluacion.size() <= 17))
        && (!('metaSemanal' in request.resource.data)
          || (request.resource.data.metaSemanal is int
            && request.resource.data.metaSemanal >= 1 && request.resource.data.metaSemanal <= 3000))
        && textoValido(request.resource.data.nombre, 2, 80)
        && instrumentosValidos(request.resource.data.instrumentos)
        && request.resource.data.terminos is list && request.resource.data.terminos.size() <= 100
        && (!('foto' in request.resource.data.diff(resource.data).affectedKeys())
          || !('foto' in request.resource.data)
          || fotoValida(uid, request.resource.data.foto));
      allow delete: if false;
    }

    // When the trial of a new profesor starts: now, or when the old one started if that document
    // had a profesor account that was deleted (bajas).
    function pruebaDesdeDe(nroDocumento) {
      let baja = /databases/$(database)/documents/bajas/$(nroDocumento);
      return exists(baja) ? get(baja).data.pruebaDesde : request.time;
    }

    // suscripciones/{uid}: the profesor's plan, one per profesor, never deleted (also kept, with
    // `baja`, when the profesor deletes their account: accounting history). The profesor
    // creates it only while registering (same batch as the profile, which requires it), as a
    // 30-day trial from the server time, or from the start of the old trial if that document
    // had a profesor account that was deleted (bajas): deleting and registering again does not
    // give a new trial. Paid plans and the trials of profesores from before the plans are
    // written by the Cloud Functions (activarPlan, planesAdmin) as the admin.
    match /suscripciones/{uid} {
      allow read: if signedIn() && uid == me();
      allow create: if signedIn() && uid == me()
        && !exists(/databases/$(database)/documents/usuarios/$(uid))
        && getAfter(/databases/$(database)/documents/usuarios/$(uid)).data.rol == 'profesor'
        && request.resource.data.keys().hasOnly(['plan', 'pruebaDesde'])
        && request.resource.data.plan == 'prueba'
        && request.resource.data.pruebaDesde == pruebaDesdeDe(getAfter(/databases/$(database)/documents/usuarios/$(uid)).data.nro_documento);
      allow update, delete: if false;
    }

    // bajas/{nro_documento}: a profesor account with that document was deleted ("Eliminar mi
    // cuenta", functions/src/cuenta.ts). Keeps only when its trial started, so registering again
    // continues that trial; its plan and payments stay in suscripciones/{uid viejo} (with `baja`)
    // and pagos. Written only by that function, never deleted. Readable one by one, like
    // documentos: registering reads it.
    match /bajas/{nroDocumento} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    // pagos/{profesorId}_{referencia}: each payment the admin recorded (activarPlan) and each
    // exception (habilitarDias, tipo "cortesia", Gs. 0). Hangs from usuarios and from the plan
    // (suscripciones/{profesorId}, which stays when the account is deleted); the profesor reads
    // their own, nobody writes from the app.
    match /pagos/{id} {
      allow read: if signedIn() && resource.data.profesorId == me();
      allow write: if false;
    }

    // telefonos/{uid}: the profesor's mobile, apart from usuarios (which every profesor can read):
    // only its owner reads it here; the admin sees it through planesAdmin. Created in the same
    // batch as the profile of a new profesor (which requires it), or later by a profesor from
    // before the phones. Deleted only with the account (eliminarCuenta). Keep the pattern in sync
    // with src/lib/telefono.ts.
    match /telefonos/{uid} {
      allow read: if signedIn() && uid == me();
      allow create, update: if signedIn() && uid == me()
        && getAfter(/databases/$(database)/documents/usuarios/$(uid)).data.rol == 'profesor'
        && request.resource.data.keys().hasOnly(['telefono', 'actualizadoEn'])
        && request.resource.data.telefono is string
        && request.resource.data.telefono.matches('^[+]5959[0-9]{8}$')
        && request.resource.data.actualizadoEn == request.time;
      allow delete: if false;
    }

    // inscripciones/{profesorId}_{alumnoId}_{instrumento}: the profesor's student lists. Created
    // only by the agregarAlumno Cloud Function, which checks the plan and its limit of alumnos.
    match /inscripciones/{id} {
      allow read: if signedIn() && (resource.data.profesorId == me() || resource.data.alumnoId == me());
      allow create, update: if false;
      allow delete: if signedIn() && resource.data.profesorId == me();
    }

    // `ficha` and `bloques` are the lesson plan (src/lib/plan.ts). Rules cannot loop over the
    // blocks, so they only bound their size; files in blocks live under clases/{claseId}/ like the
    // other materials and are deleted with the class (eliminarClase).
    // `hora`, `modalidad` and `enlace`: when and where; `asistencia`: alumnoId -> state, marked
    // by the profesor; `evento`: a recital (place and program, free text).
    function claseValida(data) {
      return data.keys().hasOnly(['profesorId', 'profesorNombre', 'instrumento', 'titulo', 'descripcion', 'fecha', 'materiales', 'creadoEn', 'ficha', 'bloques', 'hora', 'modalidad', 'enlace', 'asistencia', 'evento'])
        && textoValido(data.titulo, 1, 120)
        && textoValido(data.descripcion, 0, 4000)
        && data.fecha is string && data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && archivosValidos(data.materiales)
        && (!('ficha' in data) || (data.ficha is map
          && data.ficha.keys().hasOnly(['nivel', 'estilo', 'afinacion', 'capo', 'duracion', 'superficie', 'kit'])))
        && (!('bloques' in data) || (data.bloques is list && data.bloques.size() <= 40))
        && (!('hora' in data) || (data.hora is string && data.hora.matches('^[0-2][0-9]:[0-5][0-9]$')))
        && (!('modalidad' in data) || data.modalidad in ['presencial', 'virtual'])
        && (!('enlace' in data) || (textoValido(data.enlace, 1, 500) && data.enlace.matches('^https://.*')))
        && (!('asistencia' in data) || (data.asistencia is map && data.asistencia.size() <= 300))
        && (!('evento' in data) || (data.evento is map
          && data.evento.keys().hasOnly(['tipo', 'lugar', 'programa'])
          && data.evento.tipo == 'recital'
          && textoValido(data.evento.lugar, 0, 200)
          && data.evento.programa is list && data.evento.programa.size() <= 60));
    }

    // clases/{id}: planned by a profesor; visible to the alumnos in that instrument's list.
    match /clases/{claseId} {
      allow read: if signedIn()
        && (resource.data.profesorId == me() || inscripto(resource.data.profesorId, resource.data.instrumento));
      allow create: if esProfesor()
        && habilitado(me())
        && request.resource.data.profesorId == me()
        && request.resource.data.profesorNombre == usuario(me()).nombre
        && request.resource.data.instrumento in usuario(me()).instrumentos
        && request.resource.data.creadoEn == request.time
        && claseValida(request.resource.data);
      // With the plan blocked, only attendance and removing materials.
      allow update: if signedIn() && resource.data.profesorId == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['titulo', 'descripcion', 'fecha', 'materiales', 'ficha', 'bloques', 'hora', 'modalidad', 'enlace', 'asistencia', 'evento'])
        && claseValida(request.resource.data)
        && (habilitado(me())
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['asistencia'])
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['materiales'])
            && request.resource.data.materiales.size() < resource.data.materiales.size()));
      allow delete: if signedIn() && resource.data.profesorId == me();
    }

    function clase(claseId) {
      return get(/databases/$(database)/documents/clases/$(claseId)).data;
    }

    function entregaValida(entregaId, data) {
      return data.keys().hasOnly(['claseId', 'profesorId', 'alumnoId', 'alumnoNombre', 'instrumento', 'archivos', 'comentario', 'actualizadoEn', 'devoluciones', 'evaluacion', 'respuestas'])
        && entregaId == data.claseId + '_' + me()
        && data.alumnoId == me()
        && data.alumnoNombre == usuario(me()).nombre
        && data.profesorId == clase(data.claseId).profesorId
        && data.instrumento == clase(data.claseId).instrumento
        && inscripto(data.profesorId, data.instrumento)
        && archivosValidos(data.archivos) && data.archivos.size() >= 1
        && (!('comentario' in data) || textoValido(data.comentario, 0, 2000))
        && (!('respuestas' in data) || (data.respuestas is map && data.respuestas.size() <= 100))
        && data.actualizadoEn == request.time;
    }

    // diario/{id}: what an alumno practiced (day, instrument, minutes, a note). It hangs from
    // usuarios (never deleted); the alumno creates and deletes their own entries, and a profesor
    // reads them only for an instrument they teach that alumno (the query filters by alumnoId
    // and instrumento, so the rule can check the enrollment).
    match /diario/{id} {
      allow read: if signedIn()
        && (resource.data.alumnoId == me()
          || exists(/databases/$(database)/documents/inscripciones/$(me() + '_' + resource.data.alumnoId + '_' + resource.data.instrumento)));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['alumnoId', 'instrumento', 'fecha', 'minutos', 'comentario', 'creadoEn'])
        && request.resource.data.alumnoId == me()
        && usuario(me()).rol == 'alumno'
        && instrumentosValidos([request.resource.data.instrumento])
        && request.resource.data.fecha is string && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.minutos is int
        && request.resource.data.minutos >= 1 && request.resource.data.minutos <= 600
        && textoValido(request.resource.data.comentario, 0, 500)
        && request.resource.data.creadoEn == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.alumnoId == me();
    }

    // records/{alumnoId}_{rudimento}: an alumno's best clean tempo for a drum rudiment. It hangs
    // from usuarios (never deleted); one per alumno and rudiment (deterministic id). The alumno
    // writes and deletes their own; their drum profesores read them (the query filters by
    // alumnoId, so the rule can check the enrollment).
    match /records/{id} {
      allow read: if signedIn()
        && (resource.data.alumnoId == me()
          || exists(/databases/$(database)/documents/inscripciones/$(me() + '_' + resource.data.alumnoId + '_bateria')));
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['alumnoId', 'rudimento', 'bpm', 'fecha', 'actualizadoEn'])
        && request.resource.data.alumnoId == me()
        && usuario(me()).rol == 'alumno'
        // Keep in sync with RUDIMENTOS in src/lib/bateria.ts: ids are only added, never removed
        // (a record would point at a rudiment that no longer exists).
        && request.resource.data.rudimento in ['simples', 'dobles', 'cinco-golpes', 'seis-golpes', 'paradiddle', 'doble-paradiddle', 'triple-paradiddle', 'paradiddle-diddle', 'flam', 'flam-tap', 'flam-accent', 'drag']
        && id == me() + '_' + request.resource.data.rudimento
        && request.resource.data.bpm is int
        && request.resource.data.bpm >= 20 && request.resource.data.bpm <= 300
        && request.resource.data.fecha is string && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.actualizadoEn == request.time;
      allow delete: if signedIn() && resource.data.alumnoId == me();
    }

    // asistenteUso/{uid}: the AI assistant's usage of one person (today's questions, the month's
    // tokens). One per user (same id), written only by the Cloud Function (Admin SDK); the owner
    // can read it. It hangs from usuarios, which are never deleted.
    match /asistenteUso/{uid} {
      allow read: if signedIn() && uid == me();
      allow write: if false;
    }

    // asistenteConsultas/{fecha}_{uid}: each question to the assistant with its answer or error.
    // Written only by the Cloud Function and read only through the admin panel (verBackend, Admin
    // SDK): nobody reads or writes it from the app. It hangs from usuarios, never deleted.
    match /asistenteConsultas/{id} {
      allow read, write: if false;
    }

    // The profesor's rubric of a delivery: 1-5 per criterion and a short comment.
    function evaluacionValida(e) {
      return e is map && e.keys().hasOnly(['criterios', 'comentario', 'fecha'])
        && e.criterios is map && e.criterios.size() <= 8
        && textoValido(e.comentario, 0, 1000)
        && e.fecha is int;
    }

    // `respuestas` (devolucionId -> "entendido" | "corregido") are the alumno's answers to the
    // devoluciones; the profesor can only remove them.
    // entregas/{claseId}_{alumnoId}: what an alumno uploads for a class. `devoluciones` are the
    // profesor's comments at a point of a file and `evaluacion` their rubric: stored inside the
    // delivery, so they are deleted with it (and with the class). The alumno never writes them;
    // they only remove devoluciones together with the file they point at (the new list must be
    // part of the old one).
    match /entregas/{entregaId} {
      // `resource == null`: the alumno listens to their delivery before it exists.
      allow read: if signedIn()
        && (resource == null || resource.data.alumnoId == me() || resource.data.profesorId == me());
      allow create: if signedIn() && entregaValida(entregaId, request.resource.data)
        && !('devoluciones' in request.resource.data) && !('evaluacion' in request.resource.data);
      allow update: if signedIn()
        && ((entregaValida(entregaId, request.resource.data)
            && !('evaluacion' in request.resource.data.diff(resource.data).affectedKeys())
            && (!('devoluciones' in request.resource.data.diff(resource.data).affectedKeys())
              || resource.data.get('devoluciones', []).hasAll(request.resource.data.get('devoluciones', []))))
          || (resource.data.profesorId == me()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['devoluciones', 'evaluacion', 'respuestas'])
            // The profesor only removes the alumno's answers (with the devolución they answer).
            && request.resource.data.get('respuestas', {}).diff(resource.data.get('respuestas', {})).addedKeys().size() == 0
            && request.resource.data.get('respuestas', {}).diff(resource.data.get('respuestas', {})).changedKeys().size() == 0
            && request.resource.data.get('devoluciones', []) is list
            && request.resource.data.get('devoluciones', []).size() <= 100
            && (!('evaluacion' in request.resource.data) || evaluacionValida(request.resource.data.evaluacion))));
      // The profesor too: deleting a class deletes its deliveries.
      allow delete: if signedIn() && (resource.data.alumnoId == me() || resource.data.profesorId == me());
    }

    // biblioteca/{id}: blocks a profesor saved to reuse in their classes. It hangs from usuarios
    // (never deleted) and never holds files (a files block belongs to one class).
    match /biblioteca/{id} {
      allow read: if signedIn() && resource.data.profesorId == me();
      allow create: if esProfesor()
        && request.resource.data.keys().hasOnly(['profesorId', 'instrumento', 'titulo', 'bloque', 'creadoEn'])
        && request.resource.data.profesorId == me()
        && request.resource.data.instrumento in usuario(me()).instrumentos
        && textoValido(request.resource.data.titulo, 1, 120)
        && request.resource.data.bloque is map
        && request.resource.data.bloque.tipo != 'archivos'
        && request.resource.data.creadoEn == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.profesorId == me();
    }

    // logros/{profesorId}_{alumnoId}_{instrumento}: the alumno's learning path in that list
    // (level and objectives reached). Same id as the enrollment, which must exist; it is deleted
    // with it in one batch (quitarInscripcion). The profesor writes it, the alumno reads it.
    match /logros/{id} {
      allow read: if signedIn() && (resource.data.profesorId == me() || resource.data.alumnoId == me());
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['profesorId', 'alumnoId', 'instrumento', 'nivel', 'cumplidos', 'actualizadoEn'])
        && request.resource.data.profesorId == me()
        && id == me() + '_' + request.resource.data.alumnoId + '_' + request.resource.data.instrumento
        && exists(/databases/$(database)/documents/inscripciones/$(id))
        && textoValido(request.resource.data.nivel, 1, 40)
        && request.resource.data.cumplidos is list && request.resource.data.cumplidos.size() <= 200
        && request.resource.data.actualizadoEn == request.time;
      // `resource == null`: removing an alumno who never had a path also deletes this id.
      allow delete: if signedIn() && (resource == null || resource.data.profesorId == me());
    }

    // mensajes/{id}: a conversation about one class between its profesor and one alumno of that
    // list. It hangs from the class and is deleted with it (eliminarClase).
    match /mensajes/{id} {
      allow read: if signedIn() && (resource.data.profesorId == me() || resource.data.alumnoId == me());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['claseId', 'profesorId', 'alumnoId', 'autorId', 'texto', 'tipo', 'creadoEn'])
        // "ausencia": only the alumno says they cannot come.
        && (!('tipo' in request.resource.data)
          || (request.resource.data.tipo == 'ausencia' && me() == request.resource.data.alumnoId))
        && request.resource.data.autorId == me()
        && (me() == request.resource.data.profesorId || me() == request.resource.data.alumnoId)
        && exists(/databases/$(database)/documents/clases/$(request.resource.data.claseId))
        && clase(request.resource.data.claseId).profesorId == request.resource.data.profesorId
        && exists(/databases/$(database)/documents/inscripciones/$(request.resource.data.profesorId + '_' + request.resource.data.alumnoId + '_' + clase(request.resource.data.claseId).instrumento))
        && textoValido(request.resource.data.texto, 1, 1000)
        && request.resource.data.creadoEn == request.time;
      allow update: if false;
      // The author deletes their own; the profesor deletes all of them with the class.
      allow delete: if signedIn() && (resource.data.autorId == me() || resource.data.profesorId == me());
    }

    // The two people of an enrollment (`data` has profesorId, alumnoId and instrumento): the one
    // signed in is one of them, and the enrollment exists.
    function deLaInscripcion(data) {
      return (me() == data.profesorId || me() == data.alumnoId)
        && exists(/databases/$(database)/documents/inscripciones/$(data.profesorId + '_' + data.alumnoId + '_' + data.instrumento));
    }

    function fechaValida(valor) {
      return valor is string && valor.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // repertorio/{id}: the alumno's pieces in one profesor's list and how far each one is. It
    // hangs from the enrollment and is deleted with it (quitarInscripcion). Both write it.
    match /repertorio/{id} {
      allow read: if signedIn() && (resource.data.profesorId == me() || resource.data.alumnoId == me());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['profesorId', 'alumnoId', 'instrumento', 'obra', 'estado', 'repasadoEn', 'creadoEn'])
        && deLaInscripcion(request.resource.data)
        && textoValido(request.resource.data.obra, 1, 120)
        && request.resource.data.estado in ['aprendiendo', 'entera', 'memoria', 'lista']
        && (!('repasadoEn' in request.resource.data) || fechaValida(request.resource.data.repasadoEn))
        && request.resource.data.creadoEn == request.time;
      allow update: if signedIn() && (resource.data.profesorId == me() || resource.data.alumnoId == me())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'repasadoEn'])
        && request.resource.data.estado in ['aprendiendo', 'entera', 'memoria', 'lista']
        && (!('repasadoEn' in request.resource.data) || fechaValida(request.resource.data.repasadoEn));
      allow delete: if signedIn() && (resource.data.profesorId == me() || resource.data.alumnoId == me());
    }

    // metas/{id}: a goal of one week (its Monday) agreed between the profesor and the alumno. It
    // hangs from the enrollment and is deleted with it (quitarInscripcion). Both write it.
    match /metas/{id} {
      allow read: if signedIn() && (resource.data.profesorId == me() || resource.data.alumnoId == me());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['profesorId', 'alumnoId', 'instrumento', 'texto', 'semana', 'cumplida', 'creadoEn'])
        && deLaInscripcion(request.resource.data)
        && textoValido(request.resource.data.texto, 1, 200)
        && fechaValida(request.resource.data.semana)
        && request.resource.data.cumplida is bool
        && request.resource.data.creadoEn == request.time;
      allow update: if signedIn() && (resource.data.profesorId == me() || resource.data.alumnoId == me())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cumplida'])
        && request.resource.data.cumplida is bool;
      allow delete: if signedIn() && (resource.data.profesorId == me() || resource.data.alumnoId == me());
    }

    // dispositivos/{token}: a browser that receives push notices (Firebase Cloud Messaging) for
    // one user. It hangs from usuarios (never deleted); it is deleted on "Salir", on turning the
    // notices off, and by the Cloud Function when the token stops working. Only the Function
    // (Admin SDK) reads them to send.
    match /dispositivos/{token} {
      allow read: if signedIn() && resource.data.uid == me();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'creadoEn'])
        && request.resource.data.uid == me()
        && request.resource.data.creadoEn == request.time;
      allow delete: if signedIn() && (resource == null || resource.data.uid == me());
    }
  }
}
